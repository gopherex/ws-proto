{
  "name": "@gopherex/ws-proto-transport",
  "version": "1.1.0",
  "description": "WebSocket multiplexing transport for protobuf RPC services (analog of connect-web transport).",
  "type": "module",
  "license": "MIT",
  "author": "yaroher <stolbunov.yaroslav@gmail.com>",
  "homepage": "https://github.com/gopherex/ws-proto/tree/master/packages/ws-proto-transport#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gopherex/ws-proto.git",
    "directory": "packages/ws-proto-transport"
  },
  "bugs": {
    "url": "https://github.com/gopherex/ws-proto/issues"
  },
  "keywords": [
    "websocket",
    "protobuf",
    "rpc",
    "grpc",
    "connect",
    "transport",
    "streaming",
    "buf"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:proto": "buf generate",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.45.0",
    "@bufbuild/protoc-gen-es": "^2.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  }
}
