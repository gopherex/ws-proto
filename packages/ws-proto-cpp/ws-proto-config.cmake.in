@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Protobuf CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/ws-proto-targets.cmake")
foreach(component IN ITEMS client server testing)
  set(ws-proto_${component}_FOUND TRUE)
endforeach()
if("asio" IN_LIST ws-proto_FIND_COMPONENTS AND @WS_PROTO_WITH_ASIO@)
  find_dependency(boost_asio CONFIG)
  include("${CMAKE_CURRENT_LIST_DIR}/ws-proto-asio-targets.cmake")
  set(ws-proto_asio_FOUND TRUE)
endif()
check_required_components(ws-proto)
