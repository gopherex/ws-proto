{
  "name": "ws-proto",
  "version-semver": "1.14.0-dev.1",
  "description": "C++23 protobuf RPC client and server for a host-provided WebSocket.",
  "homepage": "https://github.com/gopherex/ws-proto",
  "license": "MIT",
  "dependencies": [
    {
      "name": "protobuf",
      "version>=": "6.33.4"
    },
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "asio": {
      "description": "Boost.Asio completion-token adapters for RPC reads, results and signals",
      "dependencies": [
        "boost-asio"
      ]
    }
  }
}
